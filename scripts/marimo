#!/usr/bin/env sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PY_BIN="$ROOT_DIR/.pixi/envs/marimo-test/bin/python"

if [ ! -x "$PY_BIN" ]; then
  echo "marimo-test env not found. Run: pixi install -e marimo-test" >&2
  exit 1
fi

export PYTHONPATH="$ROOT_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY_BIN" -m marimo "$@"
